# Deployment boundary. Defaults to public when omitted. Use admin only on the private host.
APP_MODE=public

# Public/legal website and current application host (no trailing slash).
# Public deployment: APP_URL may equal PUBLIC_SITE_URL.
# Private admin deployment: APP_URL must be the private production host.
PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Public deployment only: sanitized endpoint served by the private backend.
PUBLIC_CATALOG_API_URL=

# Backward-compatible public URL fallback
SITE_URL=http://localhost:3000
SITE_DOMAIN=localhost

# Owner identity. Required by the private admin deployment to scope the catalog.
# GitHub numeric IDs are immutable; MDT07 currently uses 172265857.
OWNER_GITHUB_ID=

# Owner authentication — private admin deployment only
# Generate at least 32 cryptographically random characters.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true

# Pinterest OAuth — private admin deployment, server-side only
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/auth/callback
# At least 32 random characters; encrypts the HTTP-only OAuth session.
PINTEREST_SESSION_SECRET=

# Supabase — private admin deployment, server-side only.
# Never prefix or expose the secret as NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Pinterest API
PINTEREST_API_BASE=https://api.pinterest.com/v5
PINTEREST_SEARCH_PAGE_SIZE=25
