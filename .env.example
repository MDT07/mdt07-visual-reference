# Public application URL (no trailing slash)
SITE_URL=http://localhost:3000
SITE_DOMAIN=localhost

# Pinterest OAuth — server-side only
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/auth/callback
# At least 32 random characters; encrypts each browser's HTTP-only OAuth session
PINTEREST_SESSION_SECRET=

# Pinterest API
PINTEREST_API_BASE=https://api.pinterest.com/v5
PINTEREST_SEARCH_PAGE_SIZE=25

# Optional developer-only Agent API. Keep disabled in public production.
AGENT_API_ENABLED=false
AGENT_API_KEY=
