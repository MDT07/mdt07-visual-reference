# Deployment boundary. Defaults to public when omitted.
APP_MODE=public

# Public/legal website and current application host (no trailing slash).
# Public deployment: APP_URL may equal PUBLIC_SITE_URL.
# Private studio: APP_URL must be the private production host.
PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Backward-compatible public URL fallback
SITE_URL=http://localhost:3000
SITE_DOMAIN=localhost

# Owner authentication — private studio only
# GitHub numeric IDs are immutable; MDT07 currently uses 172265857.
OWNER_GITHUB_ID=
# Generate at least 32 cryptographically random characters.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true

# Pinterest OAuth — private studio, server-side only
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/auth/callback
# At least 32 random characters; encrypts each browser's HTTP-only OAuth session
PINTEREST_SESSION_SECRET=

# Supabase — private studio, server-side only. Never expose the secret key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Pinterest API
PINTEREST_API_BASE=https://api.pinterest.com/v5
PINTEREST_SEARCH_PAGE_SIZE=25

# Optional developer-only Agent API. Keep disabled in public production.
AGENT_API_ENABLED=false
AGENT_API_KEY=
